# Host PostgreSQL settings (used with the "host" Compose profile)
DB_POSTGRESDB_HOST=host.docker.internal
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=replace_with_your_host_postgres_password

# Container PostgreSQL settings (used with the "container" Compose profile)
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace_with_a_secure_password

# N8N Configuration
EXECUTIONS_PROCESS=main
N8N_ENCRYPTION_KEY=replace_with_a_random_encryption_key
N8N_PORT_HOST=5678

# Host Redis settings (used with the "host" Compose profile)
QUEUE_BULL_REDIS_HOST=host.docker.internal
QUEUE_BULL_REDIS_PORT=6379

# Basic Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace_with_a_secure_password
